rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}/attempts/{clueId}: each signed-in user reads and writes only their own attempts.
    match /users/{uid}/attempts/{clueId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
